# Swaloop — ortam değişkenleri
#
# Bu dosyayı `.env` olarak kopyalayıp kendi Supabase proje bilgilerinle
# doldur. Değerleri Supabase panelinde Project Settings → API altında
# bulabilirsin.

# Supabase proje URL'i (zorunlu)
VITE_SUPABASE_URL="https://<proje-id>.supabase.co"

# Herkese açık (anon / publishable) anahtar — zorunlu.
# Bu anahtar tarayıcıya gönderilir; gizli olan `service_role` anahtarını
# ASLA buraya yazma.
VITE_SUPABASE_PUBLISHABLE_KEY="<anon-public-key>"
